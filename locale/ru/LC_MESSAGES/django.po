#: templates/polls/vote.html:5
msgid "closed"
msgstr "закрыто"

#: templates/polls/vote.html:5
msgid "Could not prepare this ballot. Reload the page to try again."
msgstr ""
"Не удалось подготовить бюллетень. Перезагрузите страницу и попробуйте снова."

#: templates/polls/vote.html:5
msgid "Recording…"
