msgid "Voting mode cannot change after anonymous links have been generated."
msgstr "После создания анонимных ссылок режим голосования изменять нельзя."

#: polls/views_pages.py:264
msgid "Not anonymous"
msgstr "Не анонимный"

#: polls/views_pages.py:264
msgid "Links can only be generated for anonymous polls."
msgstr "Ссылки можно создавать только для анонимных опросов."

#: polls/views_pages.py:266 polls/views_public.py:93
msgid "Voting unavailable"
msgstr "Голосование недоступно"

#: polls/views_pages.py:266
msgid "Links can only be generated while the poll is open."
msgstr "Ссылки можно создавать только пока опрос открыт."

#: polls/views_pages.py:293
msgid "Cannot delete"
msgstr "Удаление невозможно"

#: polls/views_pages.py:293
msgid "Poll with votes or finalized results cannot be deleted."
msgstr "Опрос с голосами или завершёнными результатами удалить нельзя."

#: polls/views_public.py:47
