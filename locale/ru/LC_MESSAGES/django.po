msgid "Link expired"
msgstr "Ссылка истекла"

#: polls/views_public.py:140
msgid "Browser fingerprint is required for anonymous voting."
msgstr "Для анонимного голосования необходим отпечаток браузера."

#: polls/views_public.py:146 polls/views_public.py:170
msgid "A vote with this browser already exists."
msgstr "Голос с этого браузера уже существует."

#: polls/views_public.py:179
msgid "This link has already been used or this browser has already voted."
msgstr "Эта ссылка уже использована или с этого браузера уже голосовали."

